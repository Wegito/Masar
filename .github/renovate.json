{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "labels": ["abhaengigkeiten"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Minor- und Patch-Updates stabiler Pakete bündeln",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "Minor- und Patch-Updates"
    },
    {
      "description": "TypeScript bleibt auf 6.0: NestJS-CLI verlangt 6.0, typescript-eslint unterstützt < 6.1 (ADR 0002)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "~6.0"
    },
    {
      "description": "@types/node folgt der kleinsten unterstützten Node-Version (engines >= 24)",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Prisma 8 nur nach eigenem ADR (ADR 0004)",
      "matchPackageNames": ["prisma", "@prisma/client"],
      "allowedVersions": "<8"
    },
    {
      "description": "Major-Updates einzeln und gekennzeichnet",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ]
}
