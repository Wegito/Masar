# Vorlage für apps/api/.env (die echte .env ist nicht im Repo).
NODE_ENV=development
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (Produktion) | pretty (lesbar in der Entwicklung)
LOG_FORMAT=pretty
# Anzahl vertrauenswürdiger Proxys vor der API (ADR 0033). Lokal 0: X-Forwarded-For wird ignoriert.
# Produktion 1, für beide Wege: Caddy -> API und Caddy -> Web/Portal -> API (Web und Portal ersetzen
# den Header durch genau eine geprüfte IP, sie hängen nichts an). Nur mit 1, wenn die API
# ausschließlich von Caddy, Web und Portal erreichbar ist; sonst lässt sich die IP fälschen.
TRUST_PROXY=0

# Datenbank aus compose.yaml. Nur Entwicklungspasswörter; Produktion nutzt eigene Secrets.
# Anwendung: nur Daten lesen und schreiben (Rolle masar_app).
DATABASE_URL=postgresql://masar_app:masar_app_dev@localhost:5432/masar
# Prisma-CLI für Migrationen: darf das Schema ändern (Rolle masar_migrate).
MIGRATE_DATABASE_URL=postgresql://masar_migrate:masar_migrate_dev@localhost:5432/masar
# Feste Schattendatenbank für "prisma migrate dev" und den Migrationsabgleich in CI.
SHADOW_DATABASE_URL=postgresql://masar_migrate:masar_migrate_dev@localhost:5432/masar_shadow

# Schlüssel für QR-Codes der Tickets und Lesetokens nach Code und Telefon (ADR 0022), je base64 mit
# 32 Bytes, z. B. aus: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ohne Angabe nimmt die Entwicklung je Start einen Zufallsschlüssel; in Produktion Pflicht.
# TICKET_QR_KEY=
# BOOKING_ACCESS_KEY=
# Schlüssel für Ausweisnummern (AES-256-GCM, ADR 0016): kommagetrennt keyId:base64, je 32 Bytes,
# z. B. k1:<base64 aus dem Befehl oben>. Der erste Eintrag verschlüsselt neue Werte, alle
# entschlüsseln (Rotation: neuen Schlüssel vorn eintragen, alte stehen lassen). Ohne Angabe nimmt
# die API keine Buchung bei Firmen an, die eine Ausweisnummer verlangen (503).
# NATIONAL_ID_KEYS=

# Die folgenden Werte haben passende Standards für die Entwicklung (apps/api/src/config/env.ts).
# Sitzungs-Cookie nur über HTTPS (__Host-masar_session). Safari akzeptiert das auf
# http://localhost nicht; dort in der Entwicklung false setzen.
# SESSION_COOKIE_SECURE=true
# Origins, die zustandsändernde Anfragen schicken dürfen (CSRF-Schutz), kommagetrennt. Der Standard
# erlaubt localhost und masar.localhost (Ports 3000 und 3002).
# APP_ORIGINS=http://localhost:3000,http://localhost:3002,http://masar.localhost:3000,http://masar.localhost:3002
# Basis für Links in E-Mails (Einladung, Passwort-Reset). Wer weitere Projekte auf localhost
# betreibt, öffnet Masar besser unter http://masar.localhost:3000 und :3002: Dorthin schickt der
# Browser keine fremden localhost-Cookies (sonst droht HTTP 431). Dann hier
# PORTAL_URL=http://masar.localhost:3002 setzen, damit Links in E-Mails dorthin zeigen.
# PORTAL_URL=http://localhost:3002
# SMTP-Server; lokal Mailpit aus compose.yaml.
# SMTP_URL=smtp://localhost:1025
# Absender der E-Mails. Der Standard nutzt die reservierte Domain .invalid; in Produktion eine
# echte Absenderadresse mit SPF, DKIM und DMARC setzen (docs/betrieb/runbook.md).
# MAIL_FROM=Masar <no-reply@masar.invalid>
# Hintergrundjobs im API-Prozess: Ablauf von Buchungen und Outbox-Zustellung (ADR 0021).
# BOOKING_JOBS_ENABLED=true
