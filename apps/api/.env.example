# Vorlage für apps/api/.env (die echte .env ist nicht im Repo).
NODE_ENV=development
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (Produktion) | pretty (lesbar in der Entwicklung)
LOG_FORMAT=pretty
# Anzahl vertrauenswürdiger Proxys vor der API (ADR 0033). Lokal 0: X-Forwarded-For wird ignoriert.
# Produktion 1, für beide Wege: Caddy -> API und Caddy -> Web/Portal -> API (Web und Portal ersetzen
# den Header durch genau eine geprüfte IP, sie hängen nichts an). Nur mit 1, wenn die API
# ausschließlich von Caddy, Web und Portal erreichbar ist; sonst lässt sich die IP fälschen.
TRUST_PROXY=0

# Datenbank aus compose.yaml. Nur Entwicklungspasswörter; Produktion nutzt eigene Secrets.
# Anwendung: nur Daten lesen und schreiben (Rolle masar_app).
DATABASE_URL=postgresql://masar_app:masar_app_dev@localhost:5432/masar
# Prisma-CLI für Migrationen: darf das Schema ändern (Rolle masar_migrate).
MIGRATE_DATABASE_URL=postgresql://masar_migrate:masar_migrate_dev@localhost:5432/masar
# Feste Schattendatenbank für "prisma migrate dev" und den Migrationsabgleich in CI.
SHADOW_DATABASE_URL=postgresql://masar_migrate:masar_migrate_dev@localhost:5432/masar_shadow

# Schlüssel für QR-Codes der Tickets und Lesetokens nach Code und Telefon (ADR 0022), je base64 mit
# 32 Bytes, z. B. aus: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ohne Angabe nimmt die Entwicklung je Start einen Zufallsschlüssel; in Produktion Pflicht.
# TICKET_QR_KEY=
# BOOKING_ACCESS_KEY=
